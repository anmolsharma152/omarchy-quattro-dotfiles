#!/bin/bash
# Omarchy Theme Set Hook: Sync application themes
RAW_NAME="${1:-$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || omarchy-theme-current 2>/dev/null)}"
THEME_NAME=$(echo "$RAW_NAME" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

omarchy-theme-set-qbittorrent "$THEME_NAME" &

# Dynamic Fastfetch Theme Integration:
# If the selected theme provides a custom fastfetch.jsonc, link it.
# Check normalized slug first, then raw name, otherwise fallback to default.
THEME_FASTFETCH="$HOME/.config/omarchy/themes/$THEME_NAME/fastfetch.jsonc"
RAW_FASTFETCH="$HOME/.config/omarchy/themes/$RAW_NAME/fastfetch.jsonc"
DEFAULT_FASTFETCH="$HOME/.local/share/omarchy/etc/fastfetch/config.jsonc"
mkdir -p "$HOME/.config/fastfetch"

if [[ -f "$THEME_FASTFETCH" ]]; then
  ln -sf "$THEME_FASTFETCH" "$HOME/.config/fastfetch/config.jsonc"
elif [[ -f "$RAW_FASTFETCH" ]]; then
  ln -sf "$RAW_FASTFETCH" "$HOME/.config/fastfetch/config.jsonc"
elif [[ -f "$DEFAULT_FASTFETCH" ]]; then
  ln -sf "$DEFAULT_FASTFETCH" "$HOME/.config/fastfetch/config.jsonc"
fi
