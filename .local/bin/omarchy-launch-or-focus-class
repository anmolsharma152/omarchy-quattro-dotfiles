#!/bin/bash
# omarchy:summary=Launch an app or focus an existing window matching strictly by window class
# omarchy:args=<window-class> [launch-command]

if (($# == 0)); then
  echo "Usage: omarchy-launch-or-focus-class <window-class> [launch-command]"
  exit 1
fi

CLASS_NAME="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $CLASS_NAME"}"
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg c "$CLASS_NAME" '.[]|select(.class|test("^" + $c + "$";"i"))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  eval exec setsid $LAUNCH_COMMAND
fi
