#!/bin/bash
# Automated Media Playback Idle Inhibitor (Auto-Caffeine) for PipeWire on Omarchy
# Uses a 5-second debounce grace period and silent background operation to prevent notification flutter

has_active_audio() {
  pw-dump 2>/dev/null | jq -e '.[] | select(.type == "PipeWire:Interface:Node" and .info.props["media.class"] == "Stream/Output/Audio" and .info.state == "running")' >/dev/null 2>&1
}

is_stay_awake() {
  [[ -f "$HOME/.local/state/omarchy/indicators/stay-awake" ]]
}

consecutive_idle=0
GRACE_SECONDS=5

while true; do
  if has_active_audio; then
    consecutive_idle=0
    if ! is_stay_awake; then
      omarchy-toggle-idle stay-awake >/dev/null 2>&1 || true
    fi
  else
    if is_stay_awake; then
      ((consecutive_idle++))
      # Require 5 consecutive seconds of silence before releasing Stay Awake
      if (( consecutive_idle >= GRACE_SECONDS )); then
        omarchy-toggle-idle allow-idle >/dev/null 2>&1 || true
        consecutive_idle=0
      fi
    else
      consecutive_idle=0
    fi
  fi
  sleep 1
done
