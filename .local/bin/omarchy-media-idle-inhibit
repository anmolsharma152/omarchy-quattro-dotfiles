#!/bin/bash
# Automated Media Playback Idle Inhibitor (Auto-Caffeine) for PipeWire on Omarchy

has_active_audio() {
  # Strictly check for audio output streams whose runtime state is actively "running" (producing sound)
  pw-dump 2>/dev/null | jq -e '.[] | select(.type == "PipeWire:Interface:Node" and .info.props["media.class"] == "Stream/Output/Audio" and .info.state == "running")' >/dev/null 2>&1
}

prev_state=""

check_and_update() {
  if has_active_audio; then
    if [[ "$prev_state" != "on" ]]; then
      omarchy-toggle-idle stay-awake >/dev/null 2>&1 || true
      omarchy-notification-send -g 󰅶 "Media Playing: Stay Awake Active" -t 2000 2>/dev/null || true
      prev_state="on"
    fi
  else
    if [[ "$prev_state" != "off" ]]; then
      if [[ "$prev_state" == "on" ]]; then
        omarchy-toggle-idle allow-idle >/dev/null 2>&1 || true
        omarchy-notification-send -g 󰅶 "Media Paused: Normal Idle Restored" -t 2000 2>/dev/null || true
      fi
      prev_state="off"
    fi
  fi
}

# Initial state check
check_and_update

# Listen live to PipeWire events with periodic loop check
while true; do
  pactl subscribe 2>/dev/null | while read -r event; do
    if [[ "$event" =~ (sink-input|sink|server) ]]; then
      check_and_update
    fi
  done
  sleep 2
  check_and_update
done
